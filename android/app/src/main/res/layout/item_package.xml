<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/bg_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Best Value Badge -->
        <TextView
            android:id="@+id/tvBestBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_subscription_card"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:text="BEST VALUE"
            android:textColor="@color/bg_primary"
            android:textSize="10sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.12"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Gold top accent line (shown when best value) -->
        <View
            android:id="@+id/viewGoldAccent"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_gold_divider"
            android:visibility="gone" />

        <!-- Package Name + Price Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPackageName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    tools:text="Best Plan" />

                <TextView
                    android:id="@+id/tvPackageDescription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    tools:text="For serious traders" />
            </LinearLayout>

            <!-- Price column -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvOriginalPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp"
                    android:paintFlags="16"
                    android:visibility="gone"
                    tools:text="$49.99"
                    tools:visibility="visible" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/accent_gold"
                        android:textSize="26sp"
                        tools:text="$29.99" />

                    <TextView
                        android:id="@+id/tvDiscount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_subscription_card"
                        android:paddingHorizontal="7dp"
                        android:paddingVertical="3dp"
                        android:textColor="@color/bg_primary"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium"
                        android:visibility="gone"
                        tools:text="-40%"
                        tools:visibility="visible" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="per month"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

            </LinearLayout>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="18dp"
            android:background="@color/bg_border" />

        <!-- Features List -->
        <TextView
            android:id="@+id/tvFeatures"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.7"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            tools:text="◆  15 Trading Pairs\n◆  10 Signals per Day\n◆  Timeframes: 1H, 4H, 1D\n◆  Real-time Notifications" />

        <!-- Select Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSelectPackage"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button_green"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.12"
            android:text="@string/select_package"
            android:textColor="@color/bg_primary"
            android:textSize="14sp"
            app:backgroundTint="@null"
            app:cornerRadius="6dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
