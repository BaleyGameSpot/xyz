<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="5dp"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/bg_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Colored left indicator (green=buy / red=sell — set in code) -->
        <View
            android:id="@+id/viewTypeIndicator"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:background="@color/buy_green" />

        <!-- Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="14dp">

            <!-- Row 1: Pair name + BUY/SELL badge + Status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPair"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.02"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    tools:text="EUR/USD" />

                <TextView
                    android:id="@+id/tvSignalType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_buy"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:textSize="12sp"
                    tools:text="BUY"
                    tools:textColor="@color/buy_green" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="11sp"
                    tools:text="ACTIVE"
                    tools:textColor="@color/neutral_gray" />

            </LinearLayout>

            <!-- Row 2: Timeframe + Time + Confidence -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Timeframe chip -->
                <TextView
                    android:id="@+id/tvTimeframe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_elevated"
                    android:paddingHorizontal="9dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/accent_gold"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    tools:text="1H" />

                <!-- Signal method chip -->
                <TextView
                    android:id="@+id/tvSignalMethod"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_card_elevated"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    tools:text="BOS/CHoCH" />

                <!-- Entry price -->
                <TextView
                    android:id="@+id/tvEntryPreview"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    tools:text="Entry: 1.08542" />

                <!-- Confidence % -->
                <TextView
                    android:id="@+id/tvConfidence"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="13sp"
                    tools:text="78%"
                    tools:textColor="@color/accent_green" />

            </LinearLayout>

            <!-- Row 3: Confidence bar + time ago -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ProgressBar
                    android:id="@+id/progressConfidence"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="78"
                    android:progressTint="@color/buy_green"
                    android:progressBackgroundTint="@color/bg_border" />

                <TextView
                    android:id="@+id/tvTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    tools:text="2h ago" />

            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
