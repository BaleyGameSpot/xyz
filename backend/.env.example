APP_NAME="Trading Signals"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.yourdomain.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=trading_signals
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@tradingsignals.com"
MAIL_FROM_NAME="${APP_NAME}"

JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160

BINANCE_BASE_URL=https://api.binance.com
ALPHA_VANTAGE_API_KEY=demo
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co
TWELVE_DATA_API_KEY=demo
TWELVE_DATA_BASE_URL=https://api.twelvedata.com

FIREBASE_CREDENTIALS=/path/to/firebase-credentials.json
FCM_SERVER_KEY=your_fcm_server_key_here

BINANCE_PAYMENT_WALLET_USDT=your_usdt_wallet_address
BINANCE_PAYMENT_WALLET_BTC=your_btc_wallet_address

ADMIN_EMAIL=admin@tradingsignals.com
ADMIN_PASSWORD=change_this_secure_password

FRONTEND_URL=https://app.yourdomain.com
CORS_ALLOWED_ORIGINS="${FRONTEND_URL}"
